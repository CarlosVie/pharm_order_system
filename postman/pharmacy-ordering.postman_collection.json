{
  "info": {
    "name": "Pharmacy Ordering",
    "description": "REST API of the pharmacy ordering service. Run \"Create order\" first; it stores `orderId` and `ticket` for the other requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Patient",
      "description": "Public endpoints under /api (PatientController).",
      "item": [
        {
          "name": "List medications",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/medications",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "medications"
              ]
            },
            "description": "Catalogue with in-stock flag."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Submits an order. Saves `orderId` and `ticket` into collection variables for the following requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientName\": \"Jane Doe\",\n  \"items\": [\n    {\n      \"medication\": \"Amoxicillin\",\n      \"quantity\": 1\n    },\n    {\n      \"medication\": \"Ibuprofen\",\n      \"quantity\": 2\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set(\"orderId\", body.orderId);",
                  "pm.collectionVariables.set(\"ticket\", body.ticket);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}"
              ]
            },
            "description": "Patient-facing status view (no name or medication)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Stream order status (SSE)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/stream",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{orderId}}",
                "stream"
              ]
            },
            "description": "Server-Sent Events stream. First event is the current status. Postman keeps the connection open and shows events as they arrive."
          }
        },
        {
          "name": "Find order by ticket",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticket}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "{{ticket}}"
              ]
            },
            "description": "Resolves a ticket like A-001 to its order ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Waiting-room board",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/board",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "board"
              ]
            },
            "description": "Ticket numbers that are ready or being prepared."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Staff",
      "description": "Pharmacy staff endpoints under /api/staff (StaffController). Order of the happy path: approve -> packed -> collected.",
      "item": [
        {
          "name": "Overview",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/staff/overview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "staff",
                "overview"
              ]
            },
            "description": "Orders grouped by stage, plus stock levels."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/staff/orders/{{orderId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "staff",
                "orders",
                "{{orderId}}",
                "approve"
              ]
            },
            "description": "AWAITING_PHARMACIST -> PACKAGING (via RabbitMQ). 409 if the order is in another state, 503 if the broker is down."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject order",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/staff/orders/{{orderId}}/reject?reason=Please speak to the pharmacist at the counter.",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "staff",
                "orders",
                "{{orderId}}",
                "reject"
              ],
              "query": [
                {
                  "key": "reason",
                  "value": "Please speak to the pharmacist at the counter."
                }
              ]
            },
            "description": "AWAITING_PHARMACIST -> REJECTED. `reason` is optional (max 200 chars shown to patient)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark packed",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/staff/orders/{{orderId}}/packed",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "staff",
                "orders",
                "{{orderId}}",
                "packed"
              ]
            },
            "description": "PACKAGING -> READY."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mark collected",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/staff/orders/{{orderId}}/collected",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "staff",
                "orders",
                "{{orderId}}",
                "collected"
              ]
            },
            "description": "READY -> COLLECTED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "Out of stock (Salbutamol x5, async reject)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Salbutamol is seeded with only 2 units. The API still returns 201; stock is checked asynchronously and the order moves to REJECTED with an out-of-stock message. Check it with a GET on the returned orderId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientName\": \"Jane Doe\",\n  \"items\": [\n    {\n      \"medication\": \"Salbutamol\",\n      \"quantity\": 5\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Empty items",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Expect 400: an order needs 1 to 10 medications.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientName\": \"Jane Doe\",\n  \"items\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "00000000-0000-0000-0000-000000000000"
              ]
            },
            "description": "Expect 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve twice (illegal transition)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/staff/orders/{{orderId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "staff",
                "orders",
                "{{orderId}}",
                "approve"
              ]
            },
            "description": "Run after the order has left AWAITING_PHARMACIST. Expect 409."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "ticket",
      "value": ""
    }
  ]
}